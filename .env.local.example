# Paste the deployed Google Apps Script Web App URL here after running setup() in the script editor.
# Deploy as: Execute as = Me, Who has access = Anyone (with access).
NEXT_PUBLIC_GAS_URL=https://script.google.com/macros/s/REPLACE_ME/exec

# Optional per-event branding (read at build time — rebuild after changing).
# Leave unset for the generic defaults shown here.
NEXT_PUBLIC_EVENT_TITLE="Mini Game Mắt Việt"
NEXT_PUBLIC_EVENT_TAGLINE="Chơi mini game — nhận quà liền tay"
